# Copy to .env (gitignored) and set your own password - docker-compose.yml
# requires POSTGRES_PASSWORD to be set (no default), so `docker compose up -d`
# will fail with a clear error until you do this.
POSTGRES_USER=kseb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kseb

# Used by backend/app/db/*.py (load_csvs.py, export_csvs.py, verify_roundtrip.py).
# Host/port must match docker-compose.yml's port mapping (5433 by default) and
# the values above.
DATABASE_URL=postgresql+psycopg2://kseb:changeme@localhost:5433/kseb
